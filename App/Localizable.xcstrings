    "%@ Until a model is available, Weft guesses from each app's App Store category and each site's name.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@在有可用模型之前，Weft 会根据应用的 App Store 类别和网站名称来猜测。"
          }
        }
      }
    },
    "%@ Until it answers, Weft guesses instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@在它回应之前，Weft 会改为猜测。"
          }
        }
      }
    },
    "%@ Weft can guess instead, or use an OpenAI-compatible API.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@Weft 可以改为猜测，或使用 OpenAI 兼容 API。"
          }
        }
      }
    },
    "%@ Weft guesses from each app's App Store category and each site's name until a model is available.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@在有可用模型之前，Weft 会根据应用的 App Store 类别和网站名称来猜测。"
          }
        }
      }
    },
