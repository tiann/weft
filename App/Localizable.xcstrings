      }
    },
    "Turn on Show when coding agents work for me in Settings → Agents to see what they worked on.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置 → 智能体”中打开“显示编程智能体为我工作的时间”，即可查看它们做了什么。"
          }
        }
      }
    },
    "URL contains": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网址包含"
          }
        }
      }
    },
    "Unknown apps and sites are categorized by Apple's on-device model, so nothing is uploaded. You can pick another model in Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知的应用和网站由 Apple 的本机模型分类，不会上传任何内容。你可以在设置中选择其他模型。"
          }
        }
      }
    },
    "Unknown apps and sites are classified %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知的应用和网站由%@分类。"
